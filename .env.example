# SolveFlow AI Environment Variables Template

# Node.js Express Backend Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=solveflow_super_secret_jwt_key_2026

# Database PostgreSQL Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solveflow_db?schema=public

# Python FastAPI AI Service URL
AI_SERVICE_URL=http://localhost:8000

# Google Gemini AI API Configuration
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
