generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum ProblemSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ProblemStatus {
  OPEN
  INVESTIGATING
  SOLUTION_FOUND
  RESOLVED
  UNRESOLVED
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  passwordHash    String
  role            Role     @default(USER)
  avatar          String?
  bio             String?
  focusHoursGoal  Float    @default(6.0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tasks           Task[]
  problems        Problem[]
  dailyReviews    DailyReview[]
  metrics         ProductivityMetric[]
  insights        AIInsight[]
  notifications   Notification[]
  knowledgeBase   KnowledgeBaseEntry[]
  workSessions    WorkSession[]
  projects        Project[]
  categories      Category[]
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String   @default("#3b82f6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       Task[]
}

model Category {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  color       String   @default("#10b981")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       Task[]
  problems    Problem[]
}

model Task {
  id                String       @id @default(uuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  categoryId        String?
  category          Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  title             String
  description       String?      @db.Text
  categoryName      String       @default("General")
  projectName       String       @default("Personal Work")
  priority          TaskPriority @default(MEDIUM)
  status            TaskStatus   @default(TODO)
  deadline          DateTime?
  estimatedDuration Int          @default(60) // in minutes
  actualDuration    Int          @default(0)  // in minutes
  tags              String[]     @default([])
  notes             String?      @db.Text
  
  // AI priority engine metadata
  aiPriorityScore   Int          @default(50)
  aiRecommendation  String?      @db.Text
  importanceScore   Int          @default(3) // 1-5
  difficultyScore   Int          @default(3) // 1-5
  dependencies      String[]     @default([])

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  problems          Problem[]
  workSessions      WorkSession[]
}

model Problem {
  id                   String          @id @default(uuid())
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId               String?
  task                 Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  categoryId           String?
  category             Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  title                String
  description          String          @db.Text
  categoryName         String          @default("Technical")
  severity             ProblemSeverity @default(MEDIUM)
  status               ProblemStatus   @default(OPEN)
  date                 DateTime        @default(now())
  attempts             Int             @default(1)
  notes                String?         @db.Text

  // Root Cause Analysis fields
  whatHappened         String?         @db.Text
  whyHappened          String?         @db.Text
  whatTried            String?         @db.Text
  whatWorked           String?         @db.Text
  whatFailed           String?         @db.Text
  whatDifferentNextTime String?        @db.Text
  
  // AI Analysis cached output
  aiSummary            String?         @db.Text
  aiPossibleCauses     String[]        @default([])
  aiRecommendedSolutions String[]      @default([])
  aiBestSolution       String?         @db.Text
  aiActionPlan         String[]        @default([])
  aiPrevention         String?         @db.Text

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  knowledgeBaseEntry   KnowledgeBaseEntry?
}

model KnowledgeBaseEntry {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId       String?  @unique
  problem         Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  title           String
  category        String   @default("General")
  tags            String[] @default([])
  problemSummary  String   @db.Text
  rootCause       String   @db.Text
  solution        String   @db.Text
  prevention      String   @db.Text
  usageCount      Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DailyReview {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                DateTime @default(now())
  accomplishments     String   @db.Text
  problemsFaced       String   @db.Text
  remainingUnfinished String   @db.Text
  distractions        String   @db.Text
  wentWell            String   @db.Text
  improveTomorrow     String   @db.Text
  aiSummary           String?  @db.Text

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ProductivityMetric {
  id                      String   @id @default(uuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                    DateTime @default(now())
  totalTasks              Int      @default(0)
  completedTasks          Int      @default(0)
  pendingTasks            Int      @default(0)
  overdueTasks            Int      @default(0)
  problemsEncountered     Int      @default(0)
  problemsSolved          Int      @default(0)
  focusTimeMinutes        Int      @default(0)
  productivityPercentage  Float    @default(0.0)
  estVsActualRatio        Float    @default(1.0)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model AIInsight {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String   @db.Text
  category    String   @default("Productivity")
  impactLevel String   @default("MEDIUM") // HIGH, MEDIUM, LOW
  metricData  Json?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // DEADLINE, OVERDUE, BLOCKED, REVIEW, RECOMMENDATION
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model WorkSession {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId          String?
  task            Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  startTime       DateTime @default(now())
  endTime         DateTime?
  durationMinutes Int      @default(0)
  focusRating     Int      @default(4) // 1-5
  notes           String?  @db.Text

  createdAt       DateTime @default(now())
}
